# Unit systemd untuk PinjamRuang.
# Pasang: sudo cp deploy/pinjamruang.service /etc/systemd/system/
# Ganti GANTI_USER dengan nama user di VM (lihat: whoami). Lokasi repo diasumsikan /opt/pinjamruang.

[Unit]
Description=PinjamRuang (gunicorn + Flask)
After=network.target

[Service]
User=GANTI_USER
WorkingDirectory=/opt/pinjamruang/backend
EnvironmentFile=/opt/pinjamruang/backend/.env

# WAJIB --workers 1: data disimpan di memori satu proses (tanpa database).
# Dengan 2 worker atau lebih, tiap worker punya salinan data sendiri dan jadwal bentrok bisa lolos.
ExecStart=/opt/pinjamruang/backend/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 app:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
